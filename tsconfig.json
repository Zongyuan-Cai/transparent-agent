{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "declaration": true, "sourceMap": true, "inlineSources": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
